---
import Base from '../../layouts/Base.astro';
import Page from '../../components/Page.astro';
import { articles, getPage } from '../../lib/site.js';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.url.split('/').filter(Boolean).pop() }, props: { url: a.url } }));
}

const page = getPage(Astro.props.url);
---
<Base page={page}>
  <Page page={page} />
</Base>
