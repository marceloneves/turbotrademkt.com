---
// Ícones SVG simples usados no layout.
const { name, size = 18 } = Astro.props;
---
{name === 'check' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M5.8 10.3l2.7 2.7 5.7-5.9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'arrow' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M6 10h7M10 6.5l3.5 3.5-3.5 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'chevron' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5L13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'down' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
{name === 'home' && (
  <svg class="icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5L10 3.5l7 6M5 8v8.5h10V8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
)}
