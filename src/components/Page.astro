---
import Breadcrumb from './Breadcrumb.astro';
import Text from './Text.astro';
import Icon from './Icon.astro';
import CardsBand from './CardsBand.astro';
import { getPage, getContent, children, outgoingLinks, isNoindex, summary, QUOTE_URL } from '../lib/site.js';

const { page } = Astro.props;
const content = getContent(page.url);
const isHome = page.url === '/';
const isArticle = page.type === 'Artigo';
const isQuote = page.url === QUOTE_URL;
const parent = !isHome && page.parent !== page.url ? getPage(page.parent) : null;
const siblings = parent ? children(parent.url).filter((p) => p.type !== 'Artigo') : [];
let subpages = children(page.url);
if (isHome) subpages = subpages.filter((p) => p.type === 'Hub de serviço');
const supportHubs = isHome ? children('/').filter((p) => p.type === 'Hub de apoio') : [];
const related = outgoingLinks(page.url).filter((l) => l.to !== page.parent || isHome);
const cta = isArticle ? 'Solicitar orçamento de trade marketing' : page.cta || 'Solicitar orçamento de trade marketing';
const [firstIntro, ...restIntro] = content?.intro ?? [];
---
<section class:list={['page-hero', { 'page-hero-home': isHome }]}>
  <div class="container">
    <p class="eyebrow">{isHome ? 'Turbo Trade Marketing' : isArticle ? 'Blog' : page.type}</p>
    <h1>{isHome ? 'Agência de trade marketing com execução no PDV e dados para decidir' : page.name}</h1>
    {isHome && firstIntro && <p class="hero-lead"><Text text={firstIntro} /></p>}
    {isHome && (
      <div class="hero-actions">
        <a class="btn" href={QUOTE_URL}>{cta} <Icon name="arrow" /></a>
        <a class="btn btn-light" href="/como-trabalhamos/">Como trabalhamos</a>
      </div>
    )}
    {isHome && (
      <div class="hero-card">
        <p class="hero-card-kicker">Quando as marcas nos procuram</p>
        <ul>
          <li><Icon name="check" /><span><b>Expansão geográfica</b>Nova região ou nova rede, sem equipe no local</span></li>
          <li><Icon name="check" /><span><b>Lançamento ou sazonalidade</b>Muitas lojas em pouco tempo</span></li>
          <li><Icon name="check" /><span><b>Troca de agência</b>Execução ou relatórios que não convencem</span></li>
          <li><Icon name="check" /><span><b>Terceirização da equipe própria</b>Custo e risco de promotores na folha</span></li>
        </ul>
        <a class="side-corner" href="/como-trabalhamos/" aria-label="Como trabalhamos"><Icon name="chevron" size={16} /></a>
      </div>
    )}
  </div>
  {!isHome && (
    <div class="hero-breadcrumb">
      <div class="container"><Breadcrumb url={page.url} /></div>
    </div>
  )}
</section>

{isHome && (
  <div class="home-cards">
    <CardsBand eyebrow="Serviços" title="O que fazemos no ponto de venda" pages={subpages} pills={supportHubs} />
  </div>
)}

<section class="page-body">
  <div class="container body-grid">
    <article class="content">
      {!isHome && firstIntro && <p class="lead"><Text text={firstIntro} /></p>}
      {restIntro.map((p) => <p><Text text={p} /></p>)}

      {content?.sections.map((s) => (
        <section class="content-section">
          <h2>{s.h2}</h2>
          {s.paragraphs.map((p) => <p><Text text={p} /></p>)}
          {s.bullets.length > 0 && (
            <ul class="check-list">
              {s.bullets.map((b) => <li><Icon name="check" /><span><Text text={b} /></span></li>)}
            </ul>
          )}
        </section>
      ))}

      {isArticle && (
        <p><a class="btn" href={page.target}>Conheça: {getPage(page.target)?.name} <Icon name="arrow" /></a></p>
      )}

      {related.length > 0 && (
        <section class="content-section">
          <p class="eyebrow">Continue navegando</p>
          <h2>Veja também</h2>
          <ul class="tag-list">
            {related.map((l) => <li><a href={l.to}>{l.anchor} <Icon name="chevron" size={12} /></a></li>)}
          </ul>
        </section>
      )}
    </article>

    <aside class="sidebar">
      {!isQuote && (
        <div class="side-card side-card-navy">
          <p class="side-kicker">Fale com a Turbo Trade</p>
          <p class="side-title">{isArticle ? 'Quer aplicar isso nas suas lojas?' : 'Pronto para falar da sua operação?'}</p>
          <a class="btn btn-block" href={QUOTE_URL}>{cta}</a>
          <a class="side-corner" href={QUOTE_URL} aria-label={cta}><Icon name="chevron" size={16} /></a>
        </div>
      )}
      {siblings.length > 1 && (
        <div class="side-card">
          <p class="side-heading">{parent.name}</p>
          <ul class="side-links">
            {siblings.map((s) => (
              <li class:list={{ current: s.url === page.url }}><a href={s.url}><Icon name="chevron" size={12} />{s.name}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</section>

{!isHome && subpages.length > 0 && (
  <CardsBand
    eyebrow="Nesta seção"
    title={`Conheça ${page.url === '/blog/' ? 'os artigos' : 'as páginas'} de ${page.name.toLowerCase()}`}
    pages={subpages}
  />
)}

{content?.faq?.length > 0 && (
  <section class="faq-band">
    <div class="container faq-grid">
      <div class="faq-intro">
        <p class="eyebrow">O que você precisa saber</p>
        <h2>Perguntas frequentes</h2>
        <p>Respostas diretas às dúvidas mais comuns sobre {page.name.toLowerCase()}.</p>
      </div>
      <div class="faq-list">
        {content.faq.map((f, i) => (
          <details open={i === 0}>
            <summary><span>{f.q}</span><span class="faq-toggle"><Icon name="down" size={16} /></span></summary>
            <p><Text text={f.a} /></p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

{!isQuote && (
  <section class="cta-band">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">Como começamos</p>
        <h2>Conte como é a sua operação e receba uma proposta com escopo detalhado</h2>
        <p>Atendemos indústrias e marcas que vendem no varejo. Se você procura vaga de promotor, acesse a página de vagas.</p>
      </div>
      <div class="steps-card">
        <p class="steps-title">Como funciona</p>
        <ol>
          <li><Icon name="check" />Você informa lojas, regiões e serviços</li>
          <li><Icon name="check" />Recebe a proposta com escopo item a item</li>
          <li><Icon name="check" />Planejamos a implantação com você</li>
          <li><Icon name="check" />A execução começa, com relatórios</li>
        </ol>
        <a class="btn btn-navy" href={QUOTE_URL}>{cta} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
)}

{import.meta.env.DEV && (
  <div class="container">
    <details class="pending-box">
      <summary>Dados do mapa de arquitetura (visível só em dev)</summary>
      <dl>
        <dt>ID</dt><dd>{page.id}</dd>
        <dt>Palavra-chave</dt><dd>{page.keyword}</dd>
        {page.variations.length > 0 && <><dt>Variações</dt><dd>{page.variations.join('; ')}</dd></>}
        <dt>Intenção</dt><dd>{page.intent}{page.intentDetail && ` — ${page.intentDetail}`}</dd>
        <dt>Etapa</dt><dd>{page.stage}</dd>
        <dt>Persona</dt><dd>{page.persona}</dd>
        <dt>Prioridade</dt><dd>{page.priority}</dd>
        {isNoindex(page) && <><dt>Publicar só com</dt><dd>{page.condition} (noindex)</dd></>}
      </dl>
    </details>
  </div>
)}
