---
import { breadcrumb } from '../lib/site.js';

const { url } = Astro.props;
const trail = breadcrumb(url);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    item: new URL(t.url, Astro.site).href,
  })),
};
---
<nav class="breadcrumb" aria-label="Trilha de navegação">
  <ol>
    {trail.map((t, i) => (
      <li>{i < trail.length - 1 ? <a href={t.url}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
